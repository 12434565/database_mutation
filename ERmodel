patient
-
PATIENT_ID int PK
SEX bool
ETHNICITY varchar(50)
COHORT varchar

admission
-
case_id int PK
PATIENT_ID int FK -< patient.PATIENT_ID
SMOKING_STATUS varchar(50)
SMOKING_PACK_YEARS int
date_of_record date
OS_STATUS bool
OS_MONTHS int

treatment
-
treatment_id int PK
case_id int FK -< admission.case_id
chemotherapy_id int FK -< chemotherapy.chemotherapy_id
TKI_TREATMENT bool

chemotherapy
-
chemotherapy_id int PK
chemotherapy_state bool
chemotherapy_name varchar(100)


sample
-
Sample_Id int PK
case_id int FK -< admission.case_id
PATIENT_ID int FK -< patient.PATIENT_ID
patient_age int
STAGE varchar(50)
PURITY float
SAMPLE_TYPE_ID int FK -< sample_type.SAMPLE_TYPE_ID
SOMATIC_STATUS varchar(50)
TMB_NONSYNONYMOUS float
ONCOTREE_CODE FK -< cancer_type.ONCOTREE_CODE
HISTOLOGICAL_GRADE varchar(50)
EXOME_SEQ bool
RNA_SEQ_ANALYSIS bool
SEQUENCING_TYPE varchar(50)
Tumor_Sample_Barcode varchar(100) UNIQUE

sample_type
-
SAMPLE_TYPE_ID int PK
SAMPLE_CLASS varchar(50)

score
-
Sample_Id int PK FK -< sample.Sample_Id
IMSIG_B_CELLS float
IMSIG_INTERFERON float
IMSIG_MACROPHAGES float
IMSIG_MONOCYTES float
IMSIG_NEUTROPHILS float
IMSIG_NK_CELLS float
IMSIG_PLASMA_CELLS float
IMSIG_PROLIFERATION float
IMSIG_T_CELLS float
IMSIG_TRANSLATION float

cancer_type
-
ONCOTREE_CODE varchar(100) PK
CANCER_TYPE varchar(100)
CANCER_TYPE_DETAILED varchar(100)
ADENOCARCINOMA_SUBTYPE_WHO2015 varchar(100)

patient_cancer
-
PATIENT_ID FK >- patient.PATIENT_ID
oncotree_code FK >- cancer_type.ONCOTREE_CODE
(patient_id, oncotree_code) PK

gene
-
gene_id int PK
Entrez_Gene_Id varchar(50) 
Hugo_Symbol varchar
NCBI_Build varchar(50)
Chromosome varchar(50)
Strand char

gene-sample
-
gene_id int FK -< gene.gene_id
Sample_Id int FK -< sample.Sample_Id
mRNA-expression DECIMAL(10,5)
(gene_id, Sample_Id) PK

consequence
-
consequence_id int PK
consequence_type varchar(100)

mutation_consequence
-
mutation_id int FK -< mutations.mutation_id
consequence_id int FK -< consequence.consequence_id
(mutation_id, consequence_id) PK

mutations
-
mutation_id int PK
gene_id int FK -< gene.gene_id
Variant_Classification varchar(50)
Variant_Type varchar(50)
Reference_Allele varchar(50)
Hotspot bool
Amino_acid_change varchar(50)
Start_Position int
End_Position int
HGVSc varchar(50)
HGVSp varchar(50)
HGVSp_Short varchar(50)
RefSeq varchar(50)
Codons varchar(50)
Protein_position int
Transcript_ID varchar(50)


sample-mutation
-
Sample_Id int FK -< sample.Sample_Id
mutation_id int FK -< mutations.mutation_id
t_ref_count int
t_alt_count int
Tumor_Seq_Allele1 varchar(50)
Tumor_Seq_Allele2 varchar(50)

