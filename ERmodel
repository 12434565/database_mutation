patient
-
PATIENT_ID int PK
SEX varchar(10)
ETHNICITY varchar(50)
COHORT varchar

admission
-
case_id int PK
PATIENT_ID int FK -< patient.PATIENT_ID
SMOKING_STATUS varchar(50)
SMOKING_PACK_YEARS DECIMAL(6,2)
OS_STATUS bool
OS_MONTHS DECIMAL(6,2) 
patient_age int
STAGE varchar(50)
chemotherapy_state bool
TKI_TREATMENT bool


sample
-
Sample_Id int PK
case_id int FK -< admission.case_id
PURITY DECIMAL(5,4)
SAMPLE_TYPE_ID VARCHAR(50) FK -< sample_type.SAMPLE_TYPE_ID
SOMATIC_STATUS varchar(50)
TMB_NONSYNONYMOUS DECIMAL(10,6)
subtype_id varchar(50) FK -< cancer_subtype.subtype_id
HISTOLOGICAL_GRADE varchar(50)
EXOME_SEQ VARCHAR(50)
RNA_SEQ_ANALYSIS VARCHAR(50)
SEQUENCING_TYPE varchar(50)
Tumor_Sample_Barcode varchar(100)

sample_type
-
SAMPLE_TYPE_ID VARCHAR(50) PK
SAMPLE_CLASS varchar(50)

score
-
Sample_Id int PK FK -< sample.Sample_Id
IMSIG_B_CELLS DECIMAL(10,6)
IMSIG_INTERFERON DECIMAL(10,6)
IMSIG_MACROPHAGES DECIMAL(10,6)
IMSIG_MONOCYTES DECIMAL(10,6)
IMSIG_NEUTROPHILS DECIMAL(10,6)
IMSIG_NK_CELLS DECIMAL(10,6)
IMSIG_PLASMA_CELLS DECIMAL(10,6)
IMSIG_PROLIFERATION DECIMAL(10,6)
IMSIG_T_CELLS DECIMAL(10,6)
IMSIG_TRANSLATION DECIMAL(10,6)

cancer_type
-
ONCOTREE_CODE varchar(100) FK -< cancer_subtype.ONCOTREE_CODE
CANCER_TYPE varchar(100)
CANCER_TYPE_DETAILED varchar(100)

cancer_subtype
-
subtype_id int PK
ONCOTREE_CODE varchar(100)
SUBTYPE_MAIN varchar(100)
SUBTYPE_DETAIL varchar(100)
ICD_CODE varchar(20)

gene
-
gene_id int PK
Entrez_Gene_Id varchar(50) 
Hugo_Symbol varchar

gene_mutation
-
gene_id int FK -< gene.gene_id
mutation_id int FK -< mutations.mutation_id

gene_sample
-
gene_id int FK -< gene.gene_id
Sample_Id int FK -< sample.Sample_Id
mRNA_expression DECIMAL(10,5)
(gene_id, Sample_Id) PK

consequence
-
consequence_id int PK
consequence_type varchar(100) UNIQUE

mutation_annotation
-
mutation_id int FK -< mutations.mutation_id
consequence_id int FK -< consequence.consequence_id
Transcript_ID varchar(50)
RefSeq varchar(50)
HGVSc varchar(50)
HGVSp varchar(50)
HGVSp_Short varchar(50)
Codons varchar(50)
Protein_position int
Amino_acid_change varchar(50)
(mutation_id, Transcript_ID) PK


mutations
-
mutation_id int PK
Start_Position int
End_Position int
Chromosome varchar(50)
Strand char(1)
NCBI_Build varchar(50)
Variant_Classification varchar(50)
Variant_Type varchar(50)
Reference_Allele varchar(50)


sample_mutation
-
Sample_Id int FK -< sample.Sample_Id
mutation_id int FK -< mutations.mutation_id
t_ref_count int
t_alt_count int
Tumor_Seq_Allele1 varchar(50)
Tumor_Seq_Allele2 varchar(50)
(Sample_Id, mutation_id) PK

